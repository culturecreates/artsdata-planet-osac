  {
    "@id": "https://www.osac.ca/temporary/920ad019-60f5-4bcc-ad9b-c5057dcc3c16",
    "@type": [
      "https://schema.org/Article"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/performing-arts/event/121-PA9170/last-birds-humboldt-area-arts-council"
