  {
    "@id": "https://www.osac.ca/temporary/93cbe8ca-647a-45b7-826a-b59fcbf1c24c",
    "@type": [
      "https://schema.org/Article"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/performing-arts/event/121-PA9114/m-nestrel-with-guest-artist-vincent-lauzer-luseland-arts-council"
