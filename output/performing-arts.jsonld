  {
    "@id": "https://www.osac.ca/temporary/7a9a68d0-bc18-4bd1-a849-1888336416c5",
    "@type": [
      "https://schema.org/Article"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/performing-arts/event/121-PA9116/m-nestrel-with-guest-artist-vincent-lauzer-tisdale-arts-council"
