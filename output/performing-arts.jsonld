  {
    "@id": "https://www.osac.ca/temporary/37139ffb-a144-4609-9473-47672a7c9497",
    "@type": [
      "https://schema.org/Article"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/performing-arts/event/121-PA9173/kellie-loder-darke-hall-society-inc-"
