  {
    "@id": "https://www.osac.ca/temporary/57a80def-a6ac-400e-a917-d94cd7120643",
    "@type": [
      "https://schema.org/Article"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/performing-arts/event/121-PA9103/amanda-hagel-these-roots-take-me-home-country-roads-christmas-whitehawk-arts-council-inc-"
