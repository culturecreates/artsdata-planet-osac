  {
    "@id": "https://www.osac.ca/temporary/cf7006c5-4d31-4253-8464-d81849021adf",
    "@type": [
      "https://schema.org/Article"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/performing-arts/event/121-PA9203/laila-biali-e-a-rawlinson-centre"
