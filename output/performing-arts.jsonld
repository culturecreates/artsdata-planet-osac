  {
    "@id": "https://www.osac.ca/temporary/33dfb606-41db-4340-aabe-97fc968b12f7",
    "@type": [
      "https://schema.org/Article"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/performing-arts/event/121-PA9241/simply-queen-weyburn-concert-series"
