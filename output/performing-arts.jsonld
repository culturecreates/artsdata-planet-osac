  {
    "@id": "https://www.osac.ca/temporary/0ccaceea-91f0-4f75-b47d-06dda773d210",
    "@type": [
      "https://schema.org/Article"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/performing-arts/event/121-PA9192/amanda-hagel-these-roots-take-me-home-country-roads-christmas-swift-current-arts-council"
