  {
    "@id": "https://www.osac.ca/temporary/1a3f72b7-c6f5-4f49-a103-376abdb09438",
    "@type": [
      "https://schema.org/Article"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/performing-arts/event/121-PA9244/the-celtic-tenors-a-celtic-christmas-weyburn-concert-series"
