  {
    "@id": "https://www.osac.ca/temporary/4bdbe7db-a4dd-41de-b917-f4975f1df1af",
    "@type": [
      "https://schema.org/Article"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/performing-arts/event/121-PA9246/solidaridad-tango-lloydminster-allied-arts-council"
