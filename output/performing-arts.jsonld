  {
    "@id": "https://www.osac.ca/temporary/6a01d4ef-e34b-4315-a6be-40ae92e15489",
    "@type": [
      "https://schema.org/Article"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/performing-arts/event/121-PA9132/the-fugitives-assiniboia-district-arts-council"
