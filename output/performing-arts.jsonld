  {
    "@id": "https://www.osac.ca/temporary/95e366ae-dfcb-460a-bfd3-8a61a44f6794",
    "@type": [
      "https://schema.org/Article"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/performing-arts/event/121-PA9234/tomatoes-tried-to-kill-me-but-banjos-saved-my-life-whitehawk-arts-council-inc-"
      }
