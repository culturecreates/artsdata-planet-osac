  {
    "@id": "https://www.osac.ca/temporary/bac170ad-5ff0-49cc-a7b0-c160bd41893c",
    "@type": [
      "https://schema.org/Article"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/performing-arts/event/121-PA9235/tomatoes-tried-to-kill-me-but-banjos-saved-my-life-swift-current-arts-council"
      }
    ],
    "https://schema.org/inLanguage": [
