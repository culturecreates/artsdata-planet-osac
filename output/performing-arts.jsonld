  {
    "@id": "https://www.osac.ca/temporary/e41a0963-e838-4550-be9b-ae87a73a61b7",
    "@type": [
      "https://schema.org/Article"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/performing-arts/event/121-PA9254/duo-cordelia-regina-musical-club"
