  {
    "@id": "https://www.osac.ca/temporary/17c7eb14-8888-4ead-9c90-5b2ffcbfcd57",
    "@type": [
      "https://schema.org/Article"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/performing-arts/event/121-PA9100/the-johner-brothers-melfort-arts-council"
