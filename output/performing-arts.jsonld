  {
    "@id": "https://www.osac.ca/temporary/8bad7117-9aff-439e-818a-ce88bf2b91e1",
    "@type": [
      "https://schema.org/Article"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/performing-arts/event/121-PA9158/sitruc-james-indian-head-theatre-and-community-arts-inc-"
