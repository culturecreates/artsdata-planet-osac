  {
    "@id": "https://www.osac.ca/temporary/420510a3-ad87-46aa-9d1f-dd2ead5cb255",
    "@type": [
      "https://schema.org/Article"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/performing-arts/event/121-PA9130/the-johner-brothers-assiniboia-district-arts-council"
