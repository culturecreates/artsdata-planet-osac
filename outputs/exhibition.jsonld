  {
    "@id": "https://www.osac.ca/genid/083c6e295916e6d7",
    "@type": [
      "https://schema.org/Article"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/visual-media-arts/event/112-VA4130/labours-of-love-under-lamplight-la-ronge-arts-council&Itemid=1819"
