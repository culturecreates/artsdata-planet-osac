  {
    "@id": "https://www.osac.ca/genid/77b74336e882b6a6",
    "@type": [
      "https://schema.org/Article"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/visual-media-arts/event/112-VA4212/patrick-fernandez-mga-piraso-mula-sa-paraiso-pieces-from-paradise--melfort-arts-council&Itemid=1819"
