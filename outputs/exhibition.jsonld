    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/visual-media-arts/event/112-VA4216/patrick-fernandez-mga-piraso-mula-sa-paraiso-pieces-from-paradise--outlook-district-arts-council&Itemid=1819"
