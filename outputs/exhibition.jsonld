    "@id": "https://www.osac.ca/genid/e533926f3cc083b9",
    "@type": [
      "https://schema.org/Article"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/visual-media-arts/event/112-VA4196/vanessa-hyggen-ma-askiy-pacihcik-t-w-this-land-is-in-use--humboldt-area-arts-council&Itemid=1819"
      }
    ],
    "https://schema.org/inLanguage": [
      {
        "@language": "en",
