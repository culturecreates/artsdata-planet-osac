  {
    "@id": "https://www.osac.ca/genid/8e9b187ffbd2db24",
    "@type": [
      "https://schema.org/Article"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/visual-media-arts/event/112-VA4243/nisto-prince-albert-council-for-the-arts&Itemid=1819"
