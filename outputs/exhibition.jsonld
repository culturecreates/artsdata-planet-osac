  {
    "@id": "https://www.osac.ca/genid/8b142c544ea2b57f",
    "@type": [
      "https://schema.org/Article"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/visual-media-arts/event/112-VA4180/mohadese-movahed-the-burden-of-street-biggar-district-arts-council&Itemid=1819"
