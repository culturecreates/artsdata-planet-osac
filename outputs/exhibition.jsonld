  {
    "@id": "https://www.osac.ca/genid/2977b6cfa449f73c",
    "@type": [
      "https://schema.org/Article"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/visual-media-arts/event/112-VA4222/labours-of-love-under-lamplight-lloydminster-museum-archive&Itemid=1819"
