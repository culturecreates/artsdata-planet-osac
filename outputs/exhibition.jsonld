  {
    "@id": "https://www.osac.ca/genid/0dfe22683ddfd860",
    "@type": [
      "https://schema.org/Article"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/visual-media-arts/event/112-VA4140/labours-of-love-under-lamplight-humboldt-area-arts-council&Itemid=1819"
