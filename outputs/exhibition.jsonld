  {
    "@id": "https://www.osac.ca/genid/391cc7bb0de04c05",
    "@type": [
      "https://schema.org/Article"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/visual-media-arts/event/112-VA4248/w-knaga-melville-arts-council&Itemid=1819"
      }
    ],
    "https://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": "en-GB"
