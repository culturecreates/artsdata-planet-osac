  {
    "@id": "https://www.osac.ca/genid/6ccaafb6c9ccca93",
    "@type": [
      "https://schema.org/Article"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/visual-media-arts/event/112-VA4136/labours-of-love-under-lamplight-melville-arts-council&Itemid=1819"
      }
    ],
    "https://schema.org/inLanguage": [
      {
