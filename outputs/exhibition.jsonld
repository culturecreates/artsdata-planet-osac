  {
    "@id": "https://www.osac.ca/genid/9b1269ba8eb0acef",
    "@type": [
      "https://schema.org/Article"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/visual-media-arts/event/112-VA4135/labours-of-love-under-lamplight-melfort-arts-council&Itemid=1819"
      }
    ],
    "https://schema.org/inLanguage": [
      {
