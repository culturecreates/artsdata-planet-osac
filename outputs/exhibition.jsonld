    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/visual-media-arts/event/112-VA4184/mohadese-movahed-the-burden-of-street-leader-district-arts-council&Itemid=1819"
