    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/visual-media-arts/event/112-VA4218/patrick-fernandez-mga-piraso-mula-sa-paraiso-pieces-from-paradise--grand-coteau-heritage-cultural-centre&Itemid=1819"
