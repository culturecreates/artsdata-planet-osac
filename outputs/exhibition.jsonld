  {
    "@id": "https://www.osac.ca/genid/bd02cd036e4490f2",
    "@type": [
      "https://schema.org/Article"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.osac.ca/visual-media-arts/event/112-VA4209/patrick-fernandez-mga-piraso-mula-sa-paraiso-pieces-from-paradise--assiniboia-district-arts-council&Itemid=1819"
